rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True only when the SIGNED-IN user's OWN stored doc has role == 'admin'.
    // Reads the role from the database (not from anything the browser sends),
    // so a normal user can't fake being an admin.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // True only when the SIGNED-IN user's OWN stored doc is approved and not
    // banned. Used to gate creating listings — defense in depth alongside the
    // app's own route guard, so a pending/banned account can't post even by
    // calling Firestore directly.
    function isApprovedAndActive() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == false;
    }

    match /users/{uid} {
      // You read your own doc; an admin may read any user's doc (to review them).
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

      // On create, trust fields must be the safe defaults.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.approved == false
        && request.resource.data.role == 'student';

      allow update: if request.auth != null && (
        // Case 1 - you editing your own profile: trust fields must stay put.
        // approved, role, and banned are all locked from self-editing.
        (request.auth.uid == uid
          && request.resource.data.approved == resource.data.approved
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('banned', false) == resource.data.get('banned', false))
        ||
        // Case 2 - an admin approving/revoking/banning: may change ONLY
        // approved, verificationStatus, and/or banned. 'role' isn't in that set,
        // so no admin can be created through the app.
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'verificationStatus', 'banned']))
      );

      allow delete: if false;
    }

    match /listings/{listingId} {
      // Any signed-in user can browse listings.
      allow read: if request.auth != null;

      // Only an approved, non-banned user may post — and only as themselves.
      allow create: if isApprovedAndActive()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.category in
             ['books', 'electronics', 'clothing', 'dorm', 'gaming']
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 3;

      allow update: if request.auth != null && (
        // Owner: may edit their own listing's content, and move it between
        // active / sold / removed themselves (their own item's lifecycle).
        // sellerId can never change.
        (request.auth.uid == resource.data.sellerId
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.status in ['active', 'sold', 'removed'])
        ||
        // Admin: may change ONLY status, and only to active/removed
        // (moderation — never 'sold', that's the seller's own call).
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['active', 'removed'])
      );

      // Soft-delete only — never a real delete.
      allow delete: if false;
    }

    match /services/{serviceId} {
      // Any signed-in user can browse services.
      allow read: if request.auth != null;

      // Only an approved, non-banned user may post — and only as themselves.
      allow create: if isApprovedAndActive()
        && request.resource.data.providerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.category in
             ['tutoring', 'tech', 'design', 'writing', 'events', 'other']
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 3;

      allow update: if request.auth != null && (
        // Owner: may edit their own service's content, and move it between
        // active / paused / removed themselves (their own listing's
        // lifecycle — "paused" stands in for "sold", since a service isn't
        // bought once the way an item is). providerId can never change.
        (request.auth.uid == resource.data.providerId
          && request.resource.data.providerId == resource.data.providerId
          && request.resource.data.status in ['active', 'paused', 'removed'])
        ||
        // Admin: may change ONLY status, and only to active/removed
        // (moderation — never 'paused', that's the provider's own call).
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['active', 'removed'])
      );

      // Soft-delete only — never a real delete.
      allow delete: if false;
    }

    // A small public-safe mirror of {name, photo} per user, kept fresh by the
    // user themselves whenever they save their profile. Lets listings show a
    // seller's current name/photo without opening up reads on /users (which
    // holds email, studentId, etc).
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photo', 'updatedAt']);

      allow delete: if false;
    }

    // Wishlist/"saved" markers — one doc per (user, item) pair, doc id
    // "<uid>_<itemId>" so existence checks and unsaving are a direct
    // lookup/delete, never a query. The id format is enforced right here,
    // not just trusted from the client. itemType says which collection the
    // saved item lives in ("listing" or "service") — it isn't load-bearing
    // for access (the id format alone already proves ownership), it's there
    // so a saved doc always says what kind of thing it's pointing at.
    match /saves/{saveId} {
            allow read: if request.auth != null && saveId.split('_')[0] == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.itemType in ['listing', 'service']
        && saveId == request.auth.uid + '_' + request.resource.data.itemId;

      // Saves are create/delete only — never edited in place.
      allow update: if false;

      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }
  }
}
