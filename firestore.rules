rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True only when the SIGNED-IN user's OWN stored doc has role == 'admin'.
    // Reads the role from the database (not from anything the browser sends),
    // so a normal user can't fake being an admin.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // True only when the SIGNED-IN user's OWN stored doc is approved and not
    // banned. Used to gate creating listings — defense in depth alongside the
    // app's own route guard, so a pending/banned account can't post even by
    // calling Firestore directly.
    function isApprovedAndActive() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == false;
    }

    // ---- Reports helpers ----
    // The reported content must exist AND targetOwnerId must be its real
    // author. Admins act on targetOwnerId ("ban the poster"), so it must
    // never be something the reporter typed. A get() of a missing document
    // fails the rule, so a report on content that doesn't exist is refused.
    function reportTargetOk(d) {
      return (d.targetType == 'listing' && d.itemType == 'listing' && d.commentId == ''
          && get(/databases/$(database)/documents/listings/$(d.itemId)).data.sellerId == d.targetOwnerId)
        || (d.targetType == 'service' && d.itemType == 'service' && d.commentId == ''
          && get(/databases/$(database)/documents/services/$(d.itemId)).data.providerId == d.targetOwnerId)
        || (d.targetType == 'comment' && d.itemType == 'listing' && d.commentId != ''
          && get(/databases/$(database)/documents/listings/$(d.itemId)/comments/$(d.commentId)).data.authorId == d.targetOwnerId)
        || (d.targetType == 'comment' && d.itemType == 'service' && d.commentId != ''
          && get(/databases/$(database)/documents/services/$(d.itemId)/comments/$(d.commentId)).data.authorId == d.targetOwnerId);
    }

    // One report per person per piece of content: the doc id is
    // "<uid>_<itemId>" for a listing/service, "<uid>_<itemId>_<commentId>"
    // for a comment. Reporting twice hits the update rule and is refused.
    function reportIdOk(reportId, d) {
      return (d.targetType != 'comment' && reportId == request.auth.uid + '_' + d.itemId)
        || (d.targetType == 'comment' && reportId == request.auth.uid + '_' + d.itemId + '_' + d.commentId);
    }

    // Moderation lock (stage 14). An admin removal sets removedByAdmin: true,
    // and the owner can't change that post at all until an admin restores it.
    // Owners can never set or clear the flag. Posts without the field act as
    // removedByAdmin == false.
    function notLockedByAdmin() {
      return resource.data.get('removedByAdmin', false) != true;
    }
    function lockFlagUnchanged() {
      return request.resource.data.get('removedByAdmin', false)
          == resource.data.get('removedByAdmin', false);
    }
    // Admin writes: the flag (if sent) is a bool, and can only be true on a
    // removed post. Writing only `status` (the pre-14 admin app) still works.
    function adminLockFlagOk() {
      return request.resource.data.get('removedByAdmin', false) is bool
        && (request.resource.data.get('removedByAdmin', false) == false
            || request.resource.data.status == 'removed');
    }

    // Notification shapes (stage 14c). Each type allows exactly its own fields.
    function notifTitleOk(d) {
      return d.itemType in ['listing', 'service']
        && d.itemId is string
        && d.itemTitle is string
        && d.itemTitle.size() <= 200;
    }
    function notifShapeOk(d) {
      return (d.type == 'account_approved'
               && d.keys().hasOnly(['uid', 'type', 'createdAt']))
        || (d.type == 'post_removed'
               && d.keys().hasAll(['itemType', 'itemId', 'itemTitle', 'reason'])
               && d.keys().hasOnly(['uid', 'type', 'itemType', 'itemId', 'itemTitle', 'reason', 'createdAt'])
               && notifTitleOk(d)
               && d.reason in ['scam', 'prohibited', 'offensive', 'spam', 'other'])
        || (d.type == 'report_handled'
               && d.keys().hasAll(['itemType', 'itemId', 'itemTitle', 'outcome'])
               && d.keys().hasOnly(['uid', 'type', 'itemType', 'itemId', 'itemTitle', 'outcome', 'createdAt'])
               && notifTitleOk(d)
               && d.outcome in ['removed', 'dismissed', 'banned']);
    }

    // ---- Chat helpers (stage 15) ----
    function convDoc(convId) {
      return get(/databases/$(database)/documents/conversations/$(convId));
    }
    function isParticipant(convId) {
      return request.auth != null && request.auth.uid in convDoc(convId).data.participants;
    }
    // The chat's item must exist, not be removed, and belong to sellerId.
    function chatItemOk(d) {
      return (d.itemType == 'listing'
               && exists(/databases/$(database)/documents/listings/$(d.itemId))
               && get(/databases/$(database)/documents/listings/$(d.itemId)).data.sellerId == d.sellerId
               && get(/databases/$(database)/documents/listings/$(d.itemId)).data.status != 'removed')
        || (d.itemType == 'service'
               && exists(/databases/$(database)/documents/services/$(d.itemId))
               && get(/databases/$(database)/documents/services/$(d.itemId)).data.providerId == d.sellerId
               && get(/databases/$(database)/documents/services/$(d.itemId)).data.status != 'removed');
    }
    // Each participant has their own "last read" field.
    function myReadField() {
      return request.auth.uid == resource.data.buyerId ? 'buyerReadAt' : 'sellerReadAt';
    }
    function meetingSpots() {
      return ['library', 'canteen', 'student_union', 'main_gate', 'sports_centre'];
    }

    match /users/{uid} {
      // You read your own doc; an admin may read any user's doc (to review them).
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

      // On create, trust fields must be the safe defaults.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.approved == false
        && request.resource.data.role == 'student';

      allow update: if request.auth != null && (
        // Case 1 - you editing your own profile: trust fields must stay put.
        // approved, role, and banned are all locked from self-editing.
        (request.auth.uid == uid
          && request.resource.data.approved == resource.data.approved
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('banned', false) == resource.data.get('banned', false))
        ||
        // Case 2 - an admin approving/revoking/banning: may change ONLY
        // approved, verificationStatus, and/or banned. 'role' isn't in that set,
        // so no admin can be created through the app.
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'verificationStatus', 'banned']))
      );

      allow delete: if false;
    }

    match /listings/{listingId} {
      // Any signed-in user can browse listings.
      allow read: if request.auth != null;

      // Only an approved, non-banned user may post — and only as themselves.
      allow create: if isApprovedAndActive()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.category in
             ['books', 'electronics', 'clothing', 'dorm', 'gaming']
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 3;

      allow update: if request.auth != null && (
        // Owner: may edit their own listing's content, and move it between
        // active / sold / removed themselves (their own item's lifecycle).
        // sellerId can never change.
        // Not while an admin's removal is in force, and never the lock flag.
        (request.auth.uid == resource.data.sellerId
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.status in ['active', 'sold', 'removed']
          && notLockedByAdmin()
          && lockFlagUnchanged())
        ||
        // Admin: may change ONLY status, and only to active/removed
        // (moderation — never 'sold', that's the seller's own call).
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'removedByAdmin'])
          && request.resource.data.status in ['active', 'removed']
          && adminLockFlagOk())
      );

      // Soft-delete only — never a real delete.
      allow delete: if false;

      // Public Q&A under a listing. One doc per comment, never edited.
      // itemOwnerId is copied from the parent here and checked against it, so
      // it can't be forged. Deletes read the stored itemOwnerId instead of
      // fetching the parent again. A removed listing accepts no new comments.
      match /comments/{commentId} {
        allow read: if request.auth != null;

        allow create: if isApprovedAndActive()
          && request.resource.data.keys().hasOnly(['authorId', 'itemOwnerId', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && exists(/databases/$(database)/documents/listings/$(listingId))
          && get(/databases/$(database)/documents/listings/$(listingId)).data.status != 'removed'
          && request.resource.data.itemOwnerId ==
               get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;

        allow update: if false;

        // The author, the listing's owner, or an admin (moderation).
        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.authorId
          || request.auth.uid == resource.data.itemOwnerId
          || isAdmin());
      }
    }

    match /services/{serviceId} {
      // Any signed-in user can browse services.
      allow read: if request.auth != null;

      // Only an approved, non-banned user may post — and only as themselves.
      allow create: if isApprovedAndActive()
        && request.resource.data.providerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.category in
             ['tutoring', 'tech', 'design', 'writing', 'events', 'other']
        && request.resource.data.photos is list
        && request.resource.data.photos.size() <= 3;

      allow update: if request.auth != null && (
        // Owner: may edit their own service's content, and move it between
        // active / paused / removed themselves (their own listing's
        // lifecycle — "paused" stands in for "sold", since a service isn't
        // bought once the way an item is). providerId can never change.
        // Not while an admin's removal is in force, and never the lock flag.
        (request.auth.uid == resource.data.providerId
          && request.resource.data.providerId == resource.data.providerId
          && request.resource.data.status in ['active', 'paused', 'removed']
          && notLockedByAdmin()
          && lockFlagUnchanged())
        ||
        // Admin: may change ONLY status, and only to active/removed
        // (moderation — never 'paused', that's the provider's own call).
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'removedByAdmin'])
          && request.resource.data.status in ['active', 'removed']
          && adminLockFlagOk())
      );

      // Soft-delete only — never a real delete.
      allow delete: if false;

      // Public Q&A under a service. One doc per comment, never edited.
      // itemOwnerId is copied from the parent here and checked against it, so
      // it can't be forged. Deletes read the stored itemOwnerId instead of
      // fetching the parent again. A removed service accepts no new comments.
      match /comments/{commentId} {
        allow read: if request.auth != null;

        allow create: if isApprovedAndActive()
          && request.resource.data.keys().hasOnly(['authorId', 'itemOwnerId', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && exists(/databases/$(database)/documents/services/$(serviceId))
          && get(/databases/$(database)/documents/services/$(serviceId)).data.status != 'removed'
          && request.resource.data.itemOwnerId ==
               get(/databases/$(database)/documents/services/$(serviceId)).data.providerId
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;

        allow update: if false;

        // The author, the service's owner, or an admin (moderation).
        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.authorId
          || request.auth.uid == resource.data.itemOwnerId
          || isAdmin());
      }
    }

    // Activity feed: lets the Dashboard run ONE collection-group query over
    // every comments subcollection (listings and services) for questions on
    // the signed-in user's items. Read-only, and no wider than the nested
    // comment rules above, which already let any signed-in user read comments.
    match /{path=**}/comments/{commentId} {
      allow read: if request.auth != null;
    }

    // A small public-safe mirror of {name, photo} per user, kept fresh by the
    // user themselves whenever they save their profile. Lets listings show a
    // seller's current name/photo without opening up reads on /users (which
    // holds email, studentId, etc).
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;

      // department + memberSince are shown in chat headers (stage 15). They are
      // self-reported like the rest of the profile, so they're length/type checked only.
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photo', 'updatedAt', 'department', 'memberSince'])
        && (!('department' in request.resource.data)
            || (request.resource.data.department is string && request.resource.data.department.size() <= 80))
        && (!('memberSince' in request.resource.data) || request.resource.data.memberSince is timestamp);

      allow delete: if false;
    }

    // Wishlist/"saved" markers — one doc per (user, item) pair, doc id
    // "<uid>_<itemId>" so existence checks and unsaving are a direct
    // lookup/delete, never a query. The id format is enforced right here,
    // not just trusted from the client. itemType says which collection the
    // saved item lives in ("listing" or "service") — it isn't load-bearing
    // for access (the id format alone already proves ownership), it's there
    // so a saved doc always says what kind of thing it's pointing at.
    match /saves/{saveId} {
      // get: look up ONE save by id ("is this saved?"), even before it exists.
      allow get: if request.auth != null && saveId.split('_')[0] == request.auth.uid;
      // list: the My Saved page / Saved count. Firestore only allows a query it
      // can prove returns your own saves, so the query must filter uid == you.
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.itemType in ['listing', 'service']
        && saveId == request.auth.uid + '_' + request.resource.data.itemId;

      // Saves are create/delete only — never edited in place.
      allow update: if false;

      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Student reports of listings, services and comments, reviewed by admins.
    match /reports/{reportId} {
      // A student may check whether THEY already reported something (direct
      // lookup by id, even if it doesn't exist yet). Only admins may list or
      // read everyone's reports.
      allow get: if request.auth != null
        && (reportId.split('_')[0] == request.auth.uid || isAdmin());
      allow list: if isAdmin();

      allow create: if isApprovedAndActive()
        && request.resource.data.keys().hasOnly([
             'reporterId', 'targetType', 'itemType', 'itemId', 'commentId',
             'targetOwnerId', 'reason', 'note', 'status', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['listing', 'service', 'comment']
        && request.resource.data.itemType in ['listing', 'service']
        && request.resource.data.itemId is string
        && request.resource.data.commentId is string
        && request.resource.data.targetOwnerId != request.auth.uid
        && request.resource.data.reason in ['scam', 'prohibited', 'offensive', 'spam', 'other']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && reportIdOk(reportId, request.resource.data)
        && reportTargetOk(request.resource.data);

      // Admin resolves a report: only these four fields may change.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'action', 'resolvedBy', 'resolvedAt'])
        && request.resource.data.status in ['dismissed', 'actioned']
        && request.resource.data.action in ['dismissed', 'removed', 'banned']
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolvedAt == request.time;

      // Reports are a record — never deleted.
      allow delete: if false;
    }

    // System notifications for one student (stage 14c): "a moderator removed
    // your post", "your account was approved", "your report was handled".
    // Written only by admins; each student can list only their own; never
    // edited or deleted (Mark all as read uses users/{uid}.activitySeenAt).
    match /notifications/{notifId} {
      allow get, list: if request.auth != null && resource.data.uid == request.auth.uid;

      allow create: if isAdmin()
        && request.resource.data.uid is string
        && request.resource.data.createdAt == request.time
        && notifShapeOk(request.resource.data);

      allow update, delete: if false;
    }

    // Chat (stage 15). One conversation per item + buyer; id = itemId_buyerUid.
    // Only the two participants can read or write it. Nothing is ever deleted.
    match /conversations/{convId} {
      // The buyer may look up their own chat id before it exists ("already chatting?").
      allow get: if request.auth != null
        && ((convId.split('_').size() == 2 && convId.split('_')[1] == request.auth.uid)
            || request.auth.uid in resource.data.participants);
      // Inbox: queries must filter participants array-contains me.
      allow list: if request.auth != null && request.auth.uid in resource.data.participants;

      allow create: if isApprovedAndActive()
        && request.resource.data.keys().hasOnly([
             'itemType', 'itemId', 'itemTitle', 'buyerId', 'sellerId', 'participants',
             'createdAt', 'updatedAt', 'lastMessage', 'lastSenderId'])
        && request.resource.data.buyerId == request.auth.uid
        && convId == request.resource.data.itemId + '_' + request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.participants == [request.auth.uid, request.resource.data.sellerId]
        && request.resource.data.itemTitle is string
        && request.resource.data.itemTitle.size() <= 200
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastSenderId == ''
        && chatItemOk(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && (
          // After sending: the inbox preview, sent by me now (may also mark my own read time).
          (isApprovedAndActive()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastMessage', 'lastSenderId', 'updatedAt', myReadField()])
            && request.resource.data.lastSenderId == request.auth.uid
            && request.resource.data.updatedAt == request.time
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() <= 140
            && (!(myReadField() in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data[myReadField()] == request.time))
          ||
          // Mark as read: only my own read time, set to now.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([myReadField()])
            && request.resource.data[myReadField()] == request.time)
        );

      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isParticipant(convId);

        allow create: if isApprovedAndActive()
          && isParticipant(convId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.keys().hasOnly(['senderId', 'type', 'text', 'createdAt'])
              && request.resource.data.text is string
              && request.resource.data.text.size() >= 1
              && request.resource.data.text.size() <= 1000)
            ||
            // Meeting proposal: a fixed public spot, a time in the next 60 days, starts pending.
            (request.resource.data.type == 'meeting'
              && request.resource.data.keys().hasOnly(['senderId', 'type', 'spot', 'meetAt', 'status', 'createdAt'])
              && request.resource.data.spot in meetingSpots()
              && request.resource.data.meetAt is timestamp
              && request.resource.data.meetAt > request.time
              && request.resource.data.meetAt < request.time + duration.value(60, 'd')
              && request.resource.data.status == 'pending')
          );

        // Answering a pending proposal, once: the other person accepts/declines,
        // the sender may cancel. Text messages are never edited.
        allow update: if isApprovedAndActive()
          && isParticipant(convId)
          && resource.data.type == 'meeting'
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.respondedAt == request.time
          && ((request.auth.uid != resource.data.senderId
                && request.resource.data.status in ['accepted', 'declined'])
              || (request.auth.uid == resource.data.senderId
                && request.resource.data.status == 'cancelled'));

        allow delete: if false;
      }
    }
  }
}
